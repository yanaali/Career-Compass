# Existing optional Express AI helper
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Spring Boot + PostgreSQL (Docker Compose reads this file)
DATABASE_PASSWORD=
APP_USERNAME=compass
APP_PASSWORD=
AI_SERVICE_TOKEN=
# Existing application rows belong to this account after the ownership migration.
# If you used a different APP_USERNAME in stage 1, set local:your-username BEFORE starting.
LEGACY_OWNER=local:compass
# Compose uses the local S3 emulator. AWS uses task IAM roles and S3_BUCKET.
# For running Java outside Docker, export these as shell environment variables.
# DATABASE_URL=jdbc:postgresql://localhost:5432/career_compass
# DATABASE_USER=career_compass
